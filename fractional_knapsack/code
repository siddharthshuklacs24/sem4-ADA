#include <stdio.h>
#include <stdlib.h>

struct Item {
    int id;      // Added ID to track the object
    int value;
    int weight;
};

// Comparison function to sort items by value/weight ratio in descending order
int compare(const void* a, const void* b) {
    struct Item* item1 = (struct Item*)a;
    struct Item* item2 = (struct Item*)b;
    double r1 = (double)item1->value / item1->weight;
    double r2 = (double)item2->value / item2->weight;
    
    if (r1 < r2) return 1;
    if (r1 > r2) return -1;
    return 0;
}

void fractionalKnapsack(int W, struct Item arr[], int n) {
    // 1. Sort items based on ratio
    qsort(arr, n, sizeof(struct Item), compare);

    int curWeight = 0;
    double finalValue = 0.0;

    printf("--- Selection Process ---\n");
    printf("%-10s %-15s %-15s\n", "Object ID", "Weight Taken", "Value Added");

    for (int i = 0; i < n; i++) {
        // If adding the whole item won't overflow the capacity
        if (curWeight + arr[i].weight <= W) {
            curWeight += arr[i].weight;
            finalValue += arr[i].value;
            printf("Object %-4d %-15d %-15.2f\n", arr[i].id, arr[i].weight, (double)arr[i].value);
        } 
        // If we can only take a fraction of the item
        else {
            int remain = W - curWeight;
            double fractionValue = arr[i].value * ((double)remain / arr[i].weight);
            finalValue += fractionValue;
            
            printf("Object %-4d %-15d %-15.2f (Fractional)\n", arr[i].id, remain, fractionValue);
            
            curWeight += remain;
            break; // Knapsack is now full
        }
    }

    printf("--------------------------\n");
    printf("Total Weight in Bag: %d\n", curWeight);
    printf("Maximum total value: %.2f\n", finalValue);
}

int main() {
    int W = 50; 
    // Initializing with IDs (1, 2, 3)
    struct Item arr[] = { 
        {1, 60, 10}, 
        {2, 100, 20}, 
        {3, 120, 30} 
    };
    int n = sizeof(arr) / sizeof(arr[0]);

    fractionalKnapsack(W, arr, n);

    return 0;
}
