#include <stdio.h>

struct Item {
    int weight, profit;
    float ratio;
};

void sort(struct Item arr[], int n) {
    for(int i=0;i<n-1;i++) {
        for(int j=0;j<n-i-1;j++) {
            if(arr[j].ratio < arr[j+1].ratio) {
                struct Item temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }
}

float knapsack(struct Item arr[], int n, int W) {
    float totalProfit = 0;

    for(int i=0;i<n;i++) {
        arr[i].ratio = (float)arr[i].profit / arr[i].weight;
    }

    sort(arr, n);

    for(int i=0;i<n;i++) {
        if(W >= arr[i].weight) {
            W -= arr[i].weight;
            totalProfit += arr[i].profit;
        } else {
            totalProfit += arr[i].ratio * W;
            break;
        }
    }

    return totalProfit;
}
