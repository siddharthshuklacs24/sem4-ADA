    #include<stdio.h>
    #include<stdlib.h>


    void merge(int arr[],int low,int mid,int high) {
        //making pointers to the 2 subarrays 
        int i=low;
        int j=mid+1;
        int k=0;
        //making an array of the same size as the array given to the function
        int temp[high-low+1];

        //comparing elements from both halves and putting the smaller one into the array until 1 of them runs out
        while(i<=mid && j<=high) {
            if(arr[i]<=arr[j]) {
                temp[k++]=arr[i++];
            }
            else {
                temp[k++]=arr[j++];
            }
        }
        
        //copying remaining elements from any one of the remaining halves(if any) 
        while(i<=mid) {
            temp[k++]=arr[i++];
        }
        while(j<=high) {
            temp[k++]=arr[j++];
        }

        //now that our temp array is complete,we are going to copy it into our array that is passed to the function
        for(int i=low;i<=high;i++) {
            arr[i]=temp[i-low];
        }
    }
    
    //this recursively divides and then combines divided into single element
    void mergesort(int arr[],int low,int high) {
        if(low<high) {
            int mid=(low+high)/2;
            mergesort(arr,low,mid);
            mergesort(arr,mid+1,high);
            merge(arr,low,mid,high);
        }
    }

    

    void main() {
        int arr[]={1,3,5,4,2};
        int n=sizeof(arr)/sizeof(arr[0]);
        mergesort(arr,0,n-1);

        printf("sorted array:");
        for(int i=0;i<n;i++) {
            printf("%d",arr[i]);
        }
    }

