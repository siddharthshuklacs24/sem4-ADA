#include <stdlib.h>

int max(int a, int b) {
    return a > b ? a : b;
}

int maximumInvitations(int* favorite, int favoriteSize) {

    int n = favoriteSize;

    int* indegree = (int*)calloc(n, sizeof(int));
    int* depth = (int*)calloc(n, sizeof(int));

    // Calculate indegree
    for(int i = 0; i < n; i++) {
        indegree[favorite[i]]++;
    }

    // Queue for topological sort
    int* queue = (int*)malloc(n * sizeof(int));

    int front = 0;
    int rear = 0;

    // Push nodes with indegree 0
    for(int i = 0; i < n; i++) {
        if(indegree[i] == 0) {
            queue[rear++] = i;
        }
    }

    // Remove non-cycle nodes
    while(front < rear) {

        int u = queue[front++];

        int v = favorite[u];

        depth[v] = max(depth[v], depth[u] + 1);

        indegree[v]--;

        if(indegree[v] == 0) {
            queue[rear++] = v;
        }
    }

    int maxCycle = 0;
    int pairChains = 0;

    // Find cycles
    for(int i = 0; i < n; i++) {

        if(indegree[i] > 0) {

            int cycleLen = 0;
            int curr = i;

            while(indegree[curr] > 0) {

                indegree[curr] = 0;

                curr = favorite[curr];

                cycleLen++;
            }

            // Special case for cycle length 2
            if(cycleLen == 2) {

                int a = i;
                int b = favorite[i];

                pairChains += 2 + depth[a] + depth[b];
            }
            else {

                maxCycle = max(maxCycle, cycleLen);
            }
        }
    }

    free(indegree);
    free(depth);
    free(queue);

    return max(maxCycle, pairChains);
}
