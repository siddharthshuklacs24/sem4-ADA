#include <stdlib.h>

int max(int a,int b){
    return a>b?a:b;
}

int dfs(int **matrix,int i,int j,int m,int n,int **dp){

    if(dp[i][j]!=0)
        return dp[i][j];

    int dirs[4][2]={{1,0},{-1,0},{0,1},{0,-1}};
    int best=1;

    for(int d=0;d<4;d++){

        int ni=i+dirs[d][0];
        int nj=j+dirs[d][1];

        if(ni>=0 && ni<m && nj>=0 && nj<n && matrix[ni][nj] > matrix[i][j]){
            best=max(best,1+dfs(matrix,ni,nj,m,n,dp));
        }
    }

    dp[i][j]=best;
    return best;
}

int longestIncreasingPath(int** matrix, int matrixSize, int* matrixColSize) {

    if(matrixSize==0) return 0;

    int m=matrixSize;
    int n=matrixColSize[0];

    int **dp=malloc(m*sizeof(int*));
    for(int i=0;i<m;i++){
        dp[i]=calloc(n,sizeof(int));
    }

    int ans=0;

    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            ans=max(ans,dfs(matrix,i,j,m,n,dp));
        }
    }

    return ans;
}
